<% const imgUrl = (url) => { if (!url) return '/image/logo.png'; return url.startsWith('http') ? url : 'https://phimimg.com/' + url; }; %>

<div class="container page-section">
  <div class="page-header">
    <div>
      <h1><i class="fas fa-history"></i> Lịch Sử Xem</h1>
      <p class="page-sub"><%= history.length %> phim đã xem</p>
    </div>
    <div style="display:flex;gap:8px;">
      <% if (history.length > 0) { %>
        <button type="button" class="btn btn-danger btn-sm" onclick="clearHistory()">
          <i class="fas fa-trash"></i> Xóa lịch sử
        </button>
      <% } %>
      <a href="/" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i> Trang chủ</a>
    </div>
  </div>

  <% if (history.length > 0) { %>
    <div class="movie-grid">
      <% history.forEach(h => { %>
        <a href="/watch/<%= h.movieSlug %>?ep=<%= h.episodeIndex || 0 %>" class="movie-card">
          <div class="movie-card-img">
            <img src="<%= imgUrl(h.movieThumb) %>" alt="<%= h.movieName %>" loading="lazy">
            <% if (h.episodeName) { %><span class="badge ep"><%= h.episodeName %></span><% } %>
            <div class="card-overlay"><i class="fas fa-play-circle"></i></div>
          </div>
          <div class="movie-card-info">
            <h3><%= h.movieName %></h3>
            <p><%= new Date(h.watchedAt || h.updatedAt).toLocaleString('vi-VN') %></p>
          </div>
        </a>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i class="fas fa-clock"></i>
      <h1>Chưa có lịch sử xem</h1>
      <p>Xem phim khi đã đăng nhập — lịch sử sẽ tự lưu khi bạn tạm dừng hoặc rời trang</p>
      <a href="/" class="btn btn-primary btn-lg">Xem Phim Ngay</a>
    </div>
  <% } %>
</div>

<script>
async function clearHistory() {
  const ok = await showConfirm('Xóa toàn bộ lịch sử xem?', { title: 'Xóa lịch sử', confirmText: 'Xóa' });
  if (!ok) return;
  const response = await fetch('/api/history', { method: 'DELETE' });
  const data = await response.json();
  if (data.success) {
    showSuccess('Đã xóa toàn bộ lịch sử xem');
    setTimeout(() => location.reload(), 700);
  } else {
    showError(data.message || 'Không thể xóa lịch sử');
  }
}
</script>
