<div class="container page-section">
  <div class="page-header">
    <div>
      <h1><i class="fas fa-bell"></i> Thông Báo</h1>
      <p class="page-sub"><%= notifs.length %> thông báo</p>
    </div>
    <a href="/" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i> Trang chủ</a>
  </div>

  <% if (notifs.length > 0) { %>
    <div class="user-notif-list">
      <% notifs.forEach(n => { %>
        <div class="user-notif-item <%= n.read ? '' : 'unread' %>">
          <div class="user-notif-icon">
            <i class="fas fa-<%= n.type === 'personal' ? 'user' : 'bullhorn' %>"></i>
          </div>
          <div class="user-notif-body">
            <strong><%= n.title %></strong>
            <p><%= n.message %></p>
            <span class="page-sub"><%= new Date(n.createdAt).toLocaleString('vi-VN') %></span>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i class="fas fa-bell-slash"></i>
      <h1>Không có thông báo</h1>
      <p>Admin sẽ gửi thông báo hệ thống tại đây khi có cập nhật mới</p>
      <a href="/" class="btn btn-primary">Về Trang Chủ</a>
    </div>
  <% } %>
</div>
