<section class="adm-page-head">
  <div class="adm-page-actions" style="margin-bottom:0;width:100%">
    <div>
      <h1 class="adm-page-title">Quản Lý Người Dùng</h1>
      <p class="adm-page-desc"><%= (users || []).length %> người dùng trong database</p>
    </div>
    <button type="button" class="adm-btn" id="btnNewUser">
      <i class="fas fa-user-plus"></i> Thêm người dùng
    </button>
  </div>
</section>

<section class="adm-card">
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead>
        <tr>
          <th>Người dùng</th>
          <th>Email</th>
          <th>Vai trò</th>
          <th>Ngày tạo</th>
          <th>Hành động</th>
        </tr>
      </thead>
      <tbody>
        <% const list = users || []; %>
        <% if (!list.length) { %>
          <tr><td colspan="5" class="adm-empty">Không có người dùng — kiểm tra MongoDB đã kết nối chưa</td></tr>
        <% } %>
        <% list.forEach(u => { %>
          <tr>
            <td>
              <div class="adm-user-cell">
                <div class="adm-avatar"><%= (u.name || "?").charAt(0).toUpperCase() %></div>
                <div>
                  <strong><%= u.name %></strong>
                  <% if (u._id.toString() === (user && user._id ? user._id.toString() : "")) { %>
                    <span class="adm-sub">(Bạn)</span>
                  <% } %>
                </div>
              </div>
            </td>
            <td><%= u.email %></td>
            <td>
              <span class="adm-role <%= u.role %>"><%= u.role %></span>
            </td>
            <td class="adm-nowrap adm-muted"><%= new Date(u.createdAt).toLocaleString("vi-VN") %></td>
            <td>
              <% if (u._id.toString() !== (user && user._id ? user._id.toString() : "")) { %>
                <button type="button" class="btn btn-sm btn-outline btn-edit-user"
                  data-id="<%= u._id %>"
                  data-name="<%= u.name %>"
                  data-email="<%= u.email %>"
                  data-role="<%= u.role %>">
                  <i class="fas fa-edit"></i> Sửa
                </button>
                <button type="button" class="btn btn-sm btn-danger btn-delete-user" data-id="<%= u._id %>">
                  <i class="fas fa-trash"></i> Xóa
                </button>
              <% } else { %>
                <span class="adm-protected"><i class="fas fa-lock"></i> Bảo vệ</span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<div class="adm-modal-backdrop" id="userModal">
  <div class="adm-modal">
    <h3 id="userModalTitle">Thêm người dùng</h3>
    <div class="adm-error" id="userError"></div>
    <form id="userForm">
      <input type="hidden" id="userId">
      <div class="adm-form-group">
        <label for="userName">Tên</label>
        <input type="text" id="userName" required minlength="2" placeholder="Nguyễn Văn A">
      </div>
      <div class="adm-form-group">
        <label for="userEmail">Email</label>
        <input type="email" id="userEmail" required placeholder="user@email.com">
      </div>
      <div class="adm-form-group">
        <label for="userPassword">Mật khẩu <span class="adm-muted" id="pwdHint">(bắt buộc khi tạo mới)</span></label>
        <input type="password" id="userPassword" minlength="6" placeholder="Tối thiểu 6 ký tự">
      </div>
      <div class="adm-form-group">
        <label for="userRole">Vai trò</label>
        <select id="userRole">
          <option value="user">User</option>
          <option value="admin">Admin</option>
        </select>
      </div>
      <div class="adm-form-actions">
        <button type="button" class="btn btn-outline" id="userModalCancel">Hủy</button>
        <button type="submit" class="adm-btn" id="userSave">Lưu</button>
      </div>
    </form>
  </div>
</div>

<script>
(function(){
  const modal = document.getElementById('userModal');
  const form = document.getElementById('userForm');
  const btnNew = document.getElementById('btnNewUser');
  const btnCancel = document.getElementById('userModalCancel');

  function openModal(editData){
    document.getElementById('userModalTitle').textContent = editData ? 'Sửa người dùng' : 'Thêm người dùng';
    document.getElementById('userId').value = editData?.id || '';
    document.getElementById('userName').value = editData?.name || '';
    document.getElementById('userEmail').value = editData?.email || '';
    document.getElementById('userPassword').value = '';
    document.getElementById('userRole').value = editData?.role || 'user';
    document.getElementById('pwdHint').textContent = editData ? '(để trống nếu không đổi)' : '(bắt buộc khi tạo mới)';
    document.getElementById('userError').style.display = 'none';
    modal.classList.add('open');
  }

  btnNew?.addEventListener('click', () => openModal(null));
  btnCancel?.addEventListener('click', () => modal.classList.remove('open'));
  modal?.addEventListener('click', (e) => { if (e.target === modal) modal.classList.remove('open'); });

  document.querySelectorAll('.btn-edit-user').forEach(btn => {
    btn.addEventListener('click', () => openModal({
      id: btn.dataset.id,
      name: btn.dataset.name,
      email: btn.dataset.email,
      role: btn.dataset.role
    }));
  });
})();
</script>
