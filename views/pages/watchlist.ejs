<% const imgUrl = (url) => { if (!url) return '/image/logo.png'; return url.startsWith('http') ? url : 'https://phimimg.com/' + url; }; %>

<div class="container page-section">
  <div class="page-header">
    <div>
      <h1><i class="fas fa-bookmark"></i> Danh Sách Xem Sau</h1>
      <p class="page-sub"><%= list.length %> phim đã lưu</p>
    </div>
    <a href="/" class="btn btn-ghost btn-sm"><i class="fas fa-arrow-left"></i> Trang chủ</a>
  </div>

  <% if (list.length > 0) { %>
    <div class="movie-grid">
      <% list.forEach(m => { %>
        <div class="movie-card fav-card" id="wl-<%= m.movieSlug %>">
          <a href="/movie/<%= m.movieSlug %>">
            <div class="movie-card-img">
              <img src="<%= imgUrl(m.movieThumb) %>" alt="<%= m.movieName %>" loading="lazy">
              <div class="card-overlay"><i class="fas fa-play-circle"></i></div>
            </div>
            <div class="movie-card-info">
              <h3><%= m.movieName %></h3>
              <p><%= m.movieYear || '' %></p>
            </div>
          </a>
          <button class="fav-remove" onclick="removeWatchlist('<%= m.movieSlug %>')" title="Xóa">
            <i class="fas fa-times"></i>
          </button>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i class="fas fa-bookmark"></i>
      <h1>Danh sách xem sau trống</h1>
      <p>Vào trang phim và bấm <strong>Xem Sau</strong> để lưu phim xem later</p>
      <a href="/" class="btn btn-primary btn-lg">Khám Phá Phim</a>
    </div>
  <% } %>
</div>
